
page{background:#f7f8fc;color:#1d2940;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:28rpx}
.container{padding:32rpx 32rpx 64rpx}.demo{font-size:24rpx;background:#fff3d7;color:#7b5915;padding:18rpx 22rpx;border-radius:16rpx;margin-bottom:28rpx}
.eyebrow{font-size:22rpx;font-weight:600;color:#4964ba;letter-spacing:3rpx}.title{font-size:48rpx;font-weight:700;line-height:1.3;margin:16rpx 0}.subtitle{color:#64718a;line-height:1.7}
.hero{padding:40rpx 30rpx;border-radius:28rpx;background:#eaf0ff;margin:24rpx 0}.price{font-size:56rpx;font-weight:700;margin:24rpx 0 12rpx}.card{padding:28rpx;background:white;border:1rpx solid #e3e8f2;border-radius:22rpx;margin:24rpx 0}
.heading{font-size:32rpx;font-weight:650;margin-bottom:18rpx}.row{padding:16rpx 0;line-height:1.6;border-bottom:1rpx solid #edf0f5}.row:last-child{border-bottom:0}.small{font-size:24rpx;color:#64718a;line-height:1.7}
button{border-radius:18rpx;font-size:28rpx;margin-top:20rpx;background:#eaf0ff;color:#3553aa}button::after{border:0}button.primary{background:#3553aa;color:#fff}button[disabled]{background:#e7eaf0;color:#8c94a6}
.error{color:#ac3434;line-height:1.7;padding:20rpx;background:#fff0f0;border-radius:16rpx;margin:20rpx 0}.success{color:#23764a;background:#eaf8ef;padding:20rpx;border-radius:16rpx}.empty{text-align:center;color:#64718a;padding:48rpx 20rpx}
.input{border:1rpx solid #d9e1ef;border-radius:16rpx;padding:22rpx;margin:20rpx 0;background:#fff}.step{display:flex;margin:24rpx 0}.number{background:#eaf0ff;border-radius:50%;padding:8rpx 16rpx;color:#3553aa;margin-right:20rpx}.agreement{display:flex;align-items:flex-start;font-size:24rpx;line-height:1.7}
video{width:100%;border-radius:16rpx;margin-top:20rpx}.pill{display:inline-block;background:#eef2fa;color:#4964ba;border-radius:12rpx;padding:6rpx 16rpx;font-size:22rpx}
