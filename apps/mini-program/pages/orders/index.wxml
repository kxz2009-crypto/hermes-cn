<view class="container"><view wx:if="{{mode==='demo'}}" class="demo">本地演练版 · 不产生真实付款或安装权益</view>
<view class="title">我的订单</view><view class="subtitle">{{mode==='demo'?'本机演练记录。':'按当前微信账号查询订单及退款状态。'}}</view><view wx:if="{{!orders.length}}" class="card empty">还没有订单。请先在电脑完成检查。</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="heading">{{item.product.name}}</view><view class="row">¥{{item.price}} · {{item.paymentText}}</view><view class="small">{{item.id}} · {{item.time}}</view><button data-id="{{item.id}}" bindtap="open">查看订单</button><button wx:if="{{mode==='demo' && (item.paymentStatus === 'paid' || item.paymentStatus === 'pending')}}" data-id="{{item.id}}" bindtap="restore">演练关闭页面后恢复关联</button></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="primary" bindtap="check">继续免费检查</button>
</view>
